{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purdue-photography-club",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "purduephotoclub.org/*",
      "zone_name": "purduephotoclub.org"
    },
    {
      "pattern": "www.purduephotoclub.org/*",
      "zone_name": "purduephotoclub.org"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "29f2856edaec46a08c43f0d5f381f453"
    }
  ],
  "services": [
    {
      "binding": "API_WORKER",
      "service": "purdue-photography-club-api"
    }
  ]
}
