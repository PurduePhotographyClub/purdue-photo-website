---
import Layout from '../layouts/Layout.astro';
import ActivateForm from '../components/dashboard/ActivateForm';

export const prerender = false;

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}
---

<Layout title="Activate Membership — Purdue Photography Club">
  <div class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-2xl tracking-[0.1em] uppercase text-neutral-100 mb-2" style="font-family: 'Playfair Display', serif;">
          Activate Membership
        </h1>
        <p class="text-xs tracking-wider text-neutral-500">
          Enter the activation key from your TooCOOL purchase email to activate membership on this account.
        </p>
      </div>

      <ActivateForm client:load />
    </div>
  </div>
</Layout>
