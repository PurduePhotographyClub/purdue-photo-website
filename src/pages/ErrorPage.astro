---
import Layout from '../layouts/Layout.astro';

interface Props {
  code: string | number;
  title: string;
  heading: string;
  message: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  code,
  title,
  heading,
  message,
  primaryLabel = 'Back to Home',
  primaryHref = '/',
  secondaryLabel = 'View Gallery',
  secondaryHref = '/gallery',
} = Astro.props;
---

<Layout title={`${code} — Purdue Photography Club`}>
  <div class="error-page" id="parallax-root">

    <!-- Section 1: Hero -->
    <section class="parallax-section hero-section">
      <div class="absolute top-0 left-0 right-0 h-32 z-10 bg-gradient-to-b from-neutral-950 to-transparent"></div>
      <div class="parallax-bg">
        <img
          src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1920"
          alt=""
          class="parallax-img"
          data-speed="0.3"
        />
        <div class="parallax-overlay"></div>
      </div>

      <div class="hero-content" data-speed="0.5">
        <p class="pre-title">{title}</p>
        <h1 class="title-code">{code}</h1>
        <div class="scroll-hint">
          <div class="scroll-line"></div>
          <span>Scroll</span>
        </div>
      </div>
    </section>

    <!-- Section 2: Message with bokeh -->
    <section class="parallax-section message-section">
      <div class="bokeh-field">
        <div class="bokeh b1" data-speed="0.2"></div>
        <div class="bokeh b2" data-speed="0.35"></div>
        <div class="bokeh b3" data-speed="0.15"></div>
        <div class="bokeh b4" data-speed="0.28"></div>
        <div class="bokeh b5" data-speed="0.12"></div>
        <div class="bokeh b6" data-speed="0.3"></div>
        <div class="bokeh b7" data-speed="0.18"></div>
        <div class="bokeh b8" data-speed="0.22"></div>
      </div>

      <div class="message-content" data-speed="0.4">
        <h2 class="message-heading">{heading}</h2>
        <p class="message-text">{message}</p>
      </div>
    </section>

    <!-- Section 3: CTA -->
    <section class="parallax-section cta-section">
      <div class="contact-sheet" data-speed="0.2">
        <div class="contact-frame cf1"></div>
        <div class="contact-frame cf2"></div>
        <div class="contact-frame cf3"></div>
        <div class="contact-frame cf4"></div>
        <div class="contact-frame cf5"></div>
        <div class="contact-frame cf6"></div>
      </div>

      <div class="cta-content" data-speed="0.45">
        <p class="cta-label">Let's get you back on track</p>
        <div class="cta-buttons">
          <a href={primaryHref} class="btn-primary">{primaryLabel}</a>
          <a href={secondaryHref} class="btn-secondary">{secondaryLabel}</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const root = document.getElementById('parallax-root');
    if (root) {
      const elements = root.querySelectorAll('[data-speed]');

      function updateParallax() {
        const scrollY = window.scrollY;
        elements.forEach((el) => {
          const speed = parseFloat(el.getAttribute('data-speed') || '0');
          const rect = el.closest('section')?.getBoundingClientRect();
          if (!rect) return;
          const sectionTop = rect.top + scrollY;
          const offset = (scrollY - sectionTop) * speed;
          if (el.classList.contains('parallax-img')) {
            (el as HTMLElement).style.transform = `translate3d(0, ${offset * 0.5}px, 0) scale(1.15)`;
          } else {
            (el as HTMLElement).style.transform = `translate3d(0, ${offset}px, 0)`;
          }
        });
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      }, { threshold: 0.15 });

      root.querySelectorAll('.message-content, .cta-content, .hero-content').forEach(el => {
        observer.observe(el);
      });

      window.addEventListener('scroll', updateParallax, { passive: true });
      updateParallax();
    }
  </script>

  <style>
    .error-page {
      overflow-x: hidden;
    }

    /* ─── Parallax Sections ─── */
    .parallax-section {
      position: relative;
      overflow: hidden;
    }

    .parallax-bg {
      position: absolute;
      inset: -15%;
      z-index: 0;
    }
    .parallax-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) brightness(0.3);
      will-change: transform;
    }
    .parallax-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(10,10,10,0.6) 0%, rgba(10,10,10,0.3) 40%, rgba(10,10,10,0.8) 100%);
    }

    /* ─── Hero ─── */
    .hero-section {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-content {
      position: relative;
      z-index: 10;
      text-align: center;
      will-change: transform;
      opacity: 0;
      transition: opacity 0.8s ease;
    }
    .hero-content.in-view {
      opacity: 1;
    }
    .pre-title {
      font-size: 10px;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: #737373;
      margin-bottom: 1.5rem;
    }
    .title-code {
      font-family: 'Playfair Display', serif;
      font-size: clamp(6rem, 20vw, 14rem);
      letter-spacing: 0.05em;
      color: #f5f5f5;
      line-height: 0.85;
      text-shadow: 0 0 80px rgba(255,255,255,0.05);
      margin-bottom: 3rem;
    }
    .scroll-hint {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      animation: fadeInUp 1s ease 1.5s forwards;
      opacity: 0;
    }
    .scroll-hint span {
      font-size: 9px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #525252;
    }
    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, transparent, #525252);
      animation: scrollPulse 2s ease-in-out infinite;
    }

    /* ─── Message Section ─── */
    .message-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0a0a;
      border-top: 1px solid #1a1a1a;
    }
    .message-content {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 4rem 1.5rem;
      will-change: transform;
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .message-content.in-view {
      opacity: 1;
      transform: translateY(0);
    }
    .message-heading {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      color: #e5e5e5;
      letter-spacing: 0.05em;
      margin-bottom: 1.25rem;
    }
    .message-text {
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      line-height: 1.8;
      color: #525252;
      max-width: 28rem;
      margin: 0 auto;
    }

    /* ─── Bokeh ─── */
    .bokeh-field {
      position: absolute;
      inset: 0;
      z-index: 1;
      overflow: hidden;
    }
    .bokeh {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
      will-change: transform;
    }
    .b1 { width: 200px; height: 200px; top: 10%; left: 5%; }
    .b2 { width: 120px; height: 120px; top: 60%; right: 10%; }
    .b3 { width: 300px; height: 300px; bottom: 5%; left: 30%; opacity: 0.5; }
    .b4 { width: 80px; height: 80px; top: 30%; right: 25%; }
    .b5 { width: 160px; height: 160px; top: 45%; left: 15%; opacity: 0.7; }
    .b6 { width: 100px; height: 100px; top: 15%; right: 35%; }
    .b7 { width: 240px; height: 240px; bottom: 20%; right: 5%; opacity: 0.4; }
    .b8 { width: 60px; height: 60px; top: 70%; left: 50%; }

    /* ─── CTA Section ─── */
    .cta-section {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0a0a;
      border-top: 1px solid #171717;
    }
    .cta-content {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 4rem 1.5rem;
      will-change: transform;
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .cta-content.in-view {
      opacity: 1;
      transform: translateY(0);
    }
    .cta-label {
      font-size: 10px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: #525252;
      margin-bottom: 2.5rem;
    }
    .cta-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    @media (min-width: 640px) {
      .cta-buttons { flex-direction: row; justify-content: center; }
    }
    .btn-primary {
      padding: 0.75rem 2rem;
      border: 1px solid #a3a3a3;
      color: #e5e5e5;
      font-size: 11px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s;
    }
    .btn-primary:hover {
      background: white;
      color: black;
    }
    .btn-secondary {
      padding: 0.75rem 2rem;
      border: 1px solid #262626;
      color: #525252;
      font-size: 11px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s;
    }
    .btn-secondary:hover {
      border-color: #525252;
      color: white;
    }

    /* ─── Contact Sheet Background ─── */
    .contact-sheet {
      position: absolute;
      inset: 0;
      z-index: 1;
      will-change: transform;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 4px;
      padding: 10%;
      opacity: 0.04;
    }
    .contact-frame {
      border: 1px solid #333;
      background: #111;
    }

    /* ─── Animations ─── */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 0.3; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.2); }
    }
  </style>
</Layout>
