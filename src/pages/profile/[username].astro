---
import Layout from '@/layouts/Layout.astro';
import PublicProfile from '@/components/profile/PublicProfile';

export const prerender = false;

const identifier = Astro.params.username;
if (!identifier) {
  return new Response(null, { status: 404 });
}
---

<Layout title="Member Profile | Purdue Photography Club" robots="noindex, nofollow, noimageindex, noarchive">
  <PublicProfile client:load identifier={identifier} />
</Layout>
