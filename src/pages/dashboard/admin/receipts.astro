---
import AdminReceipts from '@/components/dashboard/admin/AdminReceipts';
import DashboardLayout from '@/layouts/DashboardLayout.astro';

export const prerender = false;
---

<DashboardLayout title="Receipts — Admin">
  <header class="mb-8 max-w-3xl">
    <p class="mb-3 text-[10px] uppercase tracking-[0.3em] text-neutral-600">Admin</p>
    <h1 class="text-3xl tracking-[0.06em] text-neutral-100 sm:text-4xl" style="font-family: 'Playfair Display', serif;">
      Receipts
    </h1>
    <p class="mt-3 text-xs leading-6 text-neutral-500">
      Purchases, email delivery, and Discord logs.
    </p>
  </header>
  <AdminReceipts canManage={Astro.locals.user?.role === 'admin'} client:load />
</DashboardLayout>
