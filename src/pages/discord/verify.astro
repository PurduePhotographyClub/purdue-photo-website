---
import Layout from '../../layouts/Layout.astro';
import DiscordVerificationForm from '../../components/DiscordVerificationForm';
import { env } from 'cloudflare:workers';

export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
const turnstileSiteKey = env.TURNSTILE_SITE_KEY?.trim() ?? '';
---

<Layout title="Discord Verification — Purdue Photography Club">
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-12 pb-24 md:py-16 md:pb-28">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-2xl tracking-[0.1em] uppercase text-neutral-100 mb-2" style="font-family: 'Playfair Display', serif;">
          Discord Verification
        </h1>
        <p class="text-xs tracking-wider text-neutral-500">
          Enter the code the bot sent you to verify server access.
        </p>
      </div>

      <DiscordVerificationForm client:load token={token} turnstileSiteKey={turnstileSiteKey} />
    </div>
  </div>
</Layout>
