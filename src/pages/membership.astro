---
import Layout from '../layouts/Layout.astro';
import Membership from '../components/Membership';

export const prerender = false;

const user = Astro.locals.user;
const membershipExpired = user?.membershipExpiresAt
  ? new Date(user.membershipExpiresAt) < new Date()
  : false;
const currentTier = membershipExpired ? null : user?.tier ?? null;
const currentRole = user?.role ?? null;
const isLoggedIn = !!user;
---

<Layout title="Membership | Purdue Photography Club">
  <Membership client:load currentTier={currentTier} currentRole={currentRole} isLoggedIn={isLoggedIn} />
</Layout>
