---
import '../styles/index.css';
import ReportIssueWidget from '../components/dashboard/ReportIssueWidget';
import DashboardUpdatePopup from '../components/dashboard/DashboardUpdatePopup';
import DashboardNotificationBell from '../components/dashboard/DashboardNotificationBell';
import { DASHBOARD_VERSION } from '../lib/project-config';

export const prerender = false;

interface Props {
  title?: string;
}

const { title = 'Dashboard — Purdue Photography Club' } = Astro.props;

const user = Astro.locals.user;
if (!user) {
  return new Response(null, { status: 404 });
}

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;

const isAdmin = user.role === 'admin' || user.role === 'officer';
const isAccountVerified = !!user.discordId;
const isActivated = !!user.tier || isAdmin;
const canUpgrade = user.tier === 'member' && !isAdmin;
const shouldShowNotificationBell = isAccountVerified && !['/dashboard', '/dashboard/notifications'].includes(normalizedPathname);

const verifiedNavItems = isActivated ? [
  { href: '/dashboard', label: 'Home', icon: 'home' },
  { href: '/dashboard/gallery', label: 'Gallery', icon: 'image' },
  { href: '/dashboard/darkroom', label: 'Darkroom', icon: 'flask' },
  { href: '/dashboard/studio', label: 'Studio', icon: 'camera' },
  { href: '/dashboard/equipment', label: 'Equipment', icon: 'camera' },
  { href: '/dashboard/competitions', label: 'Competitions', icon: 'trophy'},
  ...(canUpgrade ? [{ href: '/membership', label: 'Get Upgrade', icon: 'credit-card' }] : []),
  { href: '/dashboard/settings', label: 'Settings', icon: 'settings' }
] : [
  { href: '/dashboard', label: 'Home', icon: 'home' },
  { href: '/dashboard/gallery', label: 'Gallery', icon: 'image' },
  { href: '/dashboard/darkroom', label: 'Darkroom', icon: 'flask' },
  { href: '/dashboard/studio', label: 'Studio', icon: 'camera' },
  { href: '/dashboard/equipment', label: 'Equipment', icon: 'camera' },
  { href: '/membership', label: 'Get Membership', icon: 'credit-card' },
  { href: '/dashboard/settings', label: 'Settings', icon: 'settings' },
];

const navItems = isAccountVerified ? verifiedNavItems : [
  { href: '/dashboard/verify', label: 'Verify Discord', icon: 'link' },
];

const adminItems = [
  { href: '/dashboard/admin/members', label: 'Members', icon: 'users' },
  { href: '/dashboard/admin/membership', label: 'Membership', icon: 'credit-card' },
  { href: '/dashboard/admin/keys', label: 'Activation Keys', icon: 'key' },
  { href: '/dashboard/admin/gallery', label: 'Gallery', icon: 'image' },
  { href: '/dashboard/admin/competitions', label: 'Competitions', icon: 'trophy' },
  { href: '/dashboard/admin/equipment', label: 'Equipment', icon: 'camera' },
  { href: '/dashboard/admin/darkroom', label: 'Darkroom', icon: 'flask' },
  { href: '/dashboard/admin/studio', label: 'Studio', icon: 'camera' },
  { href: '/dashboard/admin/events', label: 'Events', icon: 'calendar' },
  { href: '/dashboard/admin/merch', label: 'Merch', icon: 'shopping-bag' },
  { href: '/dashboard/admin/updates', label: 'Updates', icon: 'bell' },
    { href: '/dashboard/admin/newsletter', label: 'Newsletter', icon: 'mail' },
];

const roleBadge: Record<string, string> = {
  admin: 'bg-red-900/50 text-red-300 border-red-800',
  officer: 'bg-amber-900/50 text-amber-300 border-amber-800',
  user: 'bg-neutral-900/50 text-neutral-400 border-neutral-700',
};

const tierBadge: Record<string, string> = {
  facilities: 'bg-blue-900/50 text-blue-300 border-blue-800',
  member: 'bg-green-900/50 text-green-300 border-green-800',
};
---

<!doctype html>
<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="dashboard-shell bg-neutral-950 text-neutral-100 overflow-x-hidden" style="font-family: 'Space Mono', monospace;">
    <div class="flex h-dvh min-h-dvh overflow-hidden">
      <div data-film-grain class="pointer-events-none fixed inset-0 z-50 opacity-[0.025]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E&quot;); background-repeat: repeat;"></div>
      <!-- Mobile Scrim -->
      <div id="mobile-scrim" class="fixed inset-0 bg-black/80 z-30 hidden md:hidden transition-opacity opacity-0 duration-300"></div>

      <!-- Sidebar -->
      <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 bg-neutral-950 w-[min(18rem,calc(100vw-2rem))] border-r border-neutral-800 transform -translate-x-full transition-transform duration-300 md:relative md:translate-x-0 md:w-64 flex flex-col h-dvh min-h-dvh flex-shrink-0 overflow-y-auto">
        <!-- Logo -->
        <div class="p-5 border-b border-neutral-800 flex items-center justify-between shrink-0">
          <a href="/" class="flex items-center gap-3">
            <img src="/ppc-logo.webp" alt="PPC Logo" class="w-8 h-8 rounded-full brightness-[1.8] invert" style="mix-blend-mode: screen;" />
            <span class="text-xs tracking-[0.15em] uppercase text-neutral-300" style="font-family: 'Playfair Display', serif;">
              PPC Dashboard
            </span>
          </a>
          <button id="mobile-menu-close" class="md:hidden text-neutral-400 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width={1.5} stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- User info -->
        <div class="p-5 border-b border-neutral-800">
          <p class="text-sm text-neutral-100 truncate">{user.name}</p>
          <p class="text-[10px] text-neutral-500 truncate mt-0.5">{user.email}</p>
          <div class="flex flex-wrap gap-1 mt-2">
            <span class={`inline-block px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded ${roleBadge[user.role] || roleBadge.user}`}>
              {user.role}
            </span>
            {user.tier && (
              <span class={`inline-block px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded ${tierBadge[user.tier] || tierBadge.member}`}>
                {user.tier}
              </span>
            )}
            {!isAccountVerified && (
              <span class="inline-block px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded border-amber-800 bg-amber-950/40 text-amber-300">
                Unverified
              </span>
            )}
          </div>
          {user.membershipExpiresAt && (
            <p class="text-[9px] text-neutral-600 mt-1">
              Expires: {new Date(user.membershipExpiresAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
            </p>
          )}
        </div>

        <!-- Nav -->
        <nav class="flex-1 py-4">
          <div class="px-3 mb-2">
            <p class="text-[9px] tracking-[0.3em] uppercase text-neutral-600 px-2">Menu</p>
          </div>
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-5 py-2.5 text-xs tracking-wider transition-colors ${
                pathname === item.href
                  ? 'text-white bg-white/[0.04]'
                  : 'text-neutral-500 hover:text-white hover:bg-white/[0.02]'
              }`}
            >
              {item.label}
            </a>
          ))}

          {isAdmin && isAccountVerified && (
            <>
              <div class="px-3 mt-6 mb-2">
                <p class="text-[9px] tracking-[0.3em] uppercase text-neutral-600 px-2">Admin</p>
              </div>
              {adminItems.map((item) => (
                <a
                  href={item.href}
                  class={`flex items-center gap-3 px-5 py-2.5 text-xs tracking-wider transition-colors ${
                    pathname === item.href
                      ? 'text-white bg-white/[0.04]'
                      : 'text-neutral-500 hover:text-white hover:bg-white/[0.02]'
                  }`}
                >
                  {item.label}
                </a>
              ))}
            </>
          )}
        </nav>

        <!-- Bottom -->
        <div class="p-5 border-t border-neutral-800">
          <a href="/" class="block text-[10px] tracking-[0.15em] uppercase text-neutral-600 hover:text-white transition-colors mb-3">
            &larr; Back to Site
          </a>
          <button
            id="sign-out-btn"
            class="block text-[10px] tracking-[0.15em] uppercase text-neutral-600 hover:text-red-400 transition-colors cursor-pointer"
          >
            Sign Out
          </button>
          <p class="mt-4 text-[9px] tracking-[0.18em] uppercase text-neutral-700">
            {DASHBOARD_VERSION}
          </p>
        </div>
      </aside>

      <!-- Main content -->
      <div class="min-w-0 flex-1 flex flex-col overflow-y-auto">
        {shouldShowNotificationBell && (
          <div class="hidden md:block">
            <DashboardNotificationBell client:media="(min-width: 768px)" placement="floating" />
          </div>
        )}

        <!-- Mobile header -->
        <header class="md:hidden flex flex-wrap items-center justify-between gap-3 p-4 border-b border-neutral-800 shrink-0">
          <div class="flex min-w-0 items-center gap-3">
            <button id="mobile-menu-open" class="text-neutral-400 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width={1.5} stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
            <a href="/dashboard" class="truncate text-xs tracking-[0.15em] uppercase text-neutral-300">
              Dashboard
            </a>
          </div>
          <div class="flex min-w-0 flex-wrap items-center justify-end gap-2">
            <span class={`px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded ${roleBadge[user.role] || roleBadge.user}`}>
              {user.role}
            </span>
            {user.tier && (
              <span class={`px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded ${tierBadge[user.tier] || tierBadge.member}`}>
                {user.tier}
              </span>
            )}
            {!isAccountVerified && (
              <span class="px-2 py-0.5 text-[9px] tracking-[0.15em] uppercase border rounded border-amber-800 bg-amber-950/40 text-amber-300">
                Unverified
              </span>
            )}
            {shouldShowNotificationBell && <DashboardNotificationBell client:media="(max-width: 767px)" placement="inline" />}
          </div>
        </header>


        <!-- Page content -->
        <main class="min-w-0 flex-1 p-4 sm:p-6 md:p-10">
          <slot />
        </main>
      </div>
    </div>

    {isAccountVerified && <ReportIssueWidget client:load />}
    {isAccountVerified && <DashboardUpdatePopup client:load />}

    <script>
      import { authClient } from '@/lib/auth-client';

      document.getElementById('sign-out-btn')?.addEventListener('click', async () => {
        await authClient.signOut({
          fetchOptions: {
            onSuccess: () => {
              window.location.href = '/login';
            },
          },
        });
      });

      // Mobile Menu Toggle
      const openBtn = document.getElementById('mobile-menu-open');
      const closeBtn = document.getElementById('mobile-menu-close');
      const sidebar = document.getElementById('sidebar');
      const scrim = document.getElementById('mobile-scrim');

      function toggleMenu(show: boolean) {
        if (!sidebar || !scrim) return;
        if (show) {
          scrim.classList.remove('hidden');
          requestAnimationFrame(() => {
            scrim.classList.remove('opacity-0');
            sidebar.classList.remove('-translate-x-full');
          });
        } else {
          scrim.classList.add('opacity-0');
          sidebar.classList.add('-translate-x-full');
          setTimeout(() => {
            scrim.classList.add('hidden');
          }, 300);
        }
      }

      openBtn?.addEventListener('click', () => toggleMenu(true));
      closeBtn?.addEventListener('click', () => toggleMenu(false));
      scrim?.addEventListener('click', () => toggleMenu(false));
    </script>
  </body>
</html>
