{
  "name": "purdue-photography-club",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:wrangler": "astro build && wrangler dev --config dist/server/wrangler.json --port 8789",
    "build": "astro build",
    "deploy": "npm run verify && npm run verify:deploy-artifact && wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest --verbose --no-score --yes",
    "verify": "npm test && npm run build && npm run typecheck && npm run doctor",
    "verify:deploy-artifact": "node scripts/verify-deploy-artifact.mjs"
  },
  "reactDoctor": {
    "ignore": {
      "files": ["dist/**", ".wrangler/**", ".github/skills/**"]
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@better-auth/passkey": "^1.7.7",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "astro": "^7.3.5",
    "better-auth": "^1.7.3",
    "canvas-confetti": "1.9.4",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "swr": "^2.5.1",
    "tw-animate-css": "1.4.0",
    "wrangler": "^4.145.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "miniflare": {
      "undici": "7.30.0"
    },
    "yaml-language-server": {
      "yaml": "2.9.0"
    },
    "@cloudflare/vite-plugin": "1.54.5",
    "esbuild": "0.28.2",
    "postcss": "8.5.28"
  }
}
