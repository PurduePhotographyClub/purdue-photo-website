{
  "name": "purdue-photography-club",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:wrangler": "astro build && wrangler dev --config dist/server/wrangler.json --port 8789",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest --verbose --no-score --yes",
    "verify": "npm run typecheck && npm run build && npm run doctor"
  },
  "reactDoctor": {
    "ignore": {
      "files": ["dist/**", ".wrangler/**"]
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/react": "^5.0.3",
    "@better-auth/passkey": "^1.6.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "astro": "^6.1.4",
    "better-auth": "^1.6.2",
    "canvas-confetti": "1.9.4",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-qr-code": "^2.0.18",
    "swr": "^2.4.1",
    "tw-animate-css": "1.3.8",
    "wrangler": "^4.103.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.8.4"
    },
    "@cloudflare/vite-plugin": "1.42.1",
    "esbuild": "0.28.1"
  }
}
