{
  "name": "purdue-photography-club",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:wrangler": "astro build && wrangler dev --config dist/server/wrangler.json --port 8789",
    "build": "astro build",
    "deploy": "npm run verify && npm run verify:deploy-artifact && wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest --verbose --no-score --yes",
    "verify": "npm test && npm run build && npm run typecheck && npm run doctor",
    "verify:deploy-artifact": "node scripts/verify-deploy-artifact.mjs"
  },
  "reactDoctor": {
    "ignore": {
      "files": ["dist/**", ".wrangler/**", ".github/skills/**"]
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@better-auth/passkey": "^1.6.25",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "astro": "^7.1.6",
    "better-auth": "^1.6.25",
    "canvas-confetti": "1.9.4",
    "lucide-react": "1.29.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-qr-code": "^2.0.18",
    "swr": "^2.4.2",
    "tw-animate-css": "1.4.0",
    "wrangler": "^4.115.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "sharp": "0.35.3",
    "yaml-language-server": {
      "yaml": "2.8.4"
    },
    "@cloudflare/vite-plugin": "1.46.0",
    "esbuild": "0.28.1"
  }
}
